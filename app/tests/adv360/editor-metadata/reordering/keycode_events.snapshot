behavior mouse_key_press display "mouse_key_press"
param mouse_key_press 1 0x1 "Left click"
param mouse_key_press 1 0x2 "Right click"
param mouse_key_press 1 0x4 "Middle click"
param mouse_key_press 1 0x8 "MB4 click"
param mouse_key_press 1 0x10 "MB5 click"
behavior behavior_stp_indicators display "Battery Level"
param behavior_stp_indicators 1 0x0 "Battery command"
layer 0 name "Base"
layer 1 name "Mod"
layer 2 name "Red"
